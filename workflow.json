          "mode": "fromData"
        },
        "options": {}
      },
      "id": "google-sheets",
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        560,
        240
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "googleSheetsOAuth2": {
          "id": "",
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Calculate metrics and format data for AI\nconst items = $input.all();\nconst formattedData = [];\n\nfor (const item of items) {\n  const json = item.json;\n  const impressions = parseFloat(json.Impressions) || 0;\n  const clicks = parseFloat(json.Clicks) || 0;\n  const conversions = parseFloat(json.Conversions) || 0;\n  const spend = parseFloat(json.Spend) || 0;\n\n  const ctr = impressions > 0 ? ((clicks / impressions) * 100).toFixed(2) : 0;\n  const cvr = clicks > 0 ? ((conversions / clicks) * 100).toFixed(2) : 0;\n  const cpa = conversions > 0 ? (spend / conversions).toFixed(2) : 0;\n\n  formattedData.push({\n    Date: json.Date,\n    Campaign: json.Campaign,\n    Impressions: impressions,\n    Clicks: clicks,\n    Conversions: conversions,\n    Spend: spend,\n    CTR: ctr + '%',\n    CVR: cvr + '%',\n    CPA: '$' + cpa\n  });\n}\n\n// Create a markdown table string for the AI prompt\nlet tableString = '| Date | Campaign | Cost | CTR | CVR | CPA |\\n|---|---|---|---|---|---|\\n';\nformattedData.forEach(row => {\n  tableString += `| ${row.Date} | ${row.Campaign} | $${row.Spend} | ${row.CTR} | ${row.CVR} | ${row.CPA} |\\n`;\n});\n\nreturn {\n  json: {\n    tableString,\n    totalRecords: formattedData.length\n  }\n};"
      },
      "id": "metric-calculator",
      "name": "Calculate Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.cerebras.ai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "gpt-oss-120b"
            },
            {
              "name": "messages",
              "value": "={{ [\n  {\"role\": \"system\", \"content\": \"你是一位資深數位行銷分析師。請分析提供的廣告數據。請用繁體中文撰寫，結構要清晰美觀。包含：1. 績效總結表 2. 獲利最高的廣告活動 3. 三個具體的優化建議。請直接輸出 Markdown 內容，不要有任何多餘的開場白或自我介紹。\"}, \n  {\"role\": \"user\", \"content\": $json.tableString}\n] }}"
            },
            {
              "name": "temperature",
              "value": 0.5
            }
          ]
        },
        "options": {}
      },
      "id": "cerebras-ai",
      "name": "Cerebras AI Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,

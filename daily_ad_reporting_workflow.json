            "id": "b7fd8e67-5745-4d85-9f6a-1af7ad1cb375",
            "name": "Google Sheets",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4,
            "position": [
                224,
                0
            ],
            "retryOnFail": true,
            "maxTries": 3,
            "waitBetweenTries": 5000,
            "credentials": {
                "googleSheetsOAuth2Api": {
                    "id": "",
                    "name": "Google Sheets account"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "// Calculate metrics and format data for AI\nconst items = $input.all();\nconst formattedData = [];\n\nfor (const item of items) {\n  const json = item.json;\n  const impressions = parseFloat(json.Impressions) || 0;\n  const clicks = parseFloat(json.Clicks) || 0;\n  const conversions = parseFloat(json.Conversions) || 0;\n  const spend = parseFloat(json.Spend) || 0;\n\n  const ctr = impressions > 0 ? ((clicks / impressions) * 100).toFixed(2) : 0;\n  const cvr = clicks > 0 ? ((conversions / clicks) * 100).toFixed(2) : 0;\n  const cpa = conversions > 0 ? (spend / conversions).toFixed(2) : 0;\n\n  formattedData.push({\n    Date: json.Date,\n    Campaign: json.Campaign,\n    Impressions: impressions,\n    Clicks: clicks,\n    Conversions: conversions,\n    Spend: spend,\n    CTR: ctr + '%',\n    CVR: cvr + '%',\n    CPA: '$' + cpa\n  });\n}\n\n// Create a markdown table string for the AI prompt\nlet tableString = '| Date | Campaign | Cost | CTR | CVR | CPA |\\n|---|---|---|---|---|---|\\n';\nformattedData.forEach(row => {\n  tableString += `| ${row.Date} | ${row.Campaign} | $${row.Spend} | ${row.CTR} | ${row.CVR} | ${row.CPA} |\\n`;\n});\n\nreturn {\n  json: {\n    tableString,\n    totalRecords: formattedData.length\n  }\n};"
            },
            "id": "cc6728e4-637e-4bf4-bd17-aa96a7cbdeef",
            "name": "Calculate Metrics",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                448,
                0
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.cerebras.ai/v1/chat/completions",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "model",
                            "value": "gpt-oss-120b"
                        },
                        {
                            "name": "messages",
                            "value": "={{ [\n  {\"role\": \"system\", \"content\": \"你是一位資深數位行銷分析師。請分析提供的廣告數據。請用繁體中文撰寫，結構要清晰美觀。包含：1. 績效總結表 2. 獲利最高的廣告活動 3. 三個具體的優化建議。請直接輸出 Markdown 內容，不要有任何多餘的開場白或自我介紹。\"}, \n  {\"role\": \"user\", \"content\": $json.tableString}\n] }}"
                        },
                        {
                            "name": "temperature",
                            "value": 0.5
                        }
                    ]
                },
                "options": {}
            },
            "id": "deca0ce9-e6a6-4b63-a4d1-dacea5540935",
            "name": "Cerebras AI Analysis",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                672,
                0
            ],
            "retryOnFail": true,
            "maxTries": 3,
            "waitBetweenTries": 5000,
            "credentials": {
                "httpHeaderAuth": {
                    "id": "",
                    "name": "Header Auth account"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "/**\n * A simple Markdown to HTML converter in pure JS\n * for better compatibility across n8n versions.\n */\nlet md = $json.choices[0].message.content;\n\nlet html = md\n  .replace(/### (.*)/g, '<h3>$1</h3>')\n  .replace(/## (.*)/g, '<h2>$1</h2>')\n  .replace(/# (.*)/g, '<h1>$1</h1>')\n  .replace(/\\*\\*(.*)\\*\\*/g, '<b>$1</b>')\n  .replace(/\\*(.*)\\*/g, '<i>$1</i>')\n  .replace(/\\|/g, '│') // Simple replacement for table borders\n  .replace(/\\n/g, '<br>');\n\n// Wrap in a simple container\nconst finalHtml = `<div style=\"font-family: sans-serif; line-height: 1.6; color: #333;\">${html}</div>`;\n\nreturn { html: finalHtml };"
            },
            "id": "324f1d62-ce0a-4269-81d7-af58eb3c75c7",
            "name": "Format to HTML",
            "type": "n8n-nodes-base.code",
